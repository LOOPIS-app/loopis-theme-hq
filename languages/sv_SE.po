msgid "First name"
msgstr "Förnamn"

msgid "Last name"
msgstr "Efternamn"

msgid "Password"
msgstr "Lösenord"

msgid "Confirm password"
msgstr "Bekräfta lösenord"

msgid "Please enter your first name."
msgstr "Ange ditt förnamn."

msgid "Please enter your last name."
msgstr "Ange ditt efternamn."

msgid "Please enter a password."
msgstr "Ange ett lösenord."

msgid "Password must be at least 8 characters long."
msgstr "Lösenordet måste vara minst 8 tecken långt."

msgid "Password confirmation does not match."
msgstr "Lösenordsbekräftelsen matchar inte."

msgid "Please provide a valid first and last name to generate a username."
msgstr "Ange ett giltigt för- och efternamn för att skapa ett användarnamn."

msgid "This username is invalid. Please use only lowercase letters, numbers, and hyphens."
msgstr "Det här användarnamnet är ogiltigt. Använd endast små bokstäver, siffror och bindestreck."

msgid "Username must be at least 4 characters long after generation."
msgstr "Användarnamnet måste vara minst 4 tecken långt efter generering."

msgid "Sorry, that username is not allowed."
msgstr "Tyvärr, det användarnamnet är inte tillåtet."
